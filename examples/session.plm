            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 5 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 6 == pc.n.0 and win.used.0 < 6 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 5 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 6 == pc.n.0 and win.used.0 < 6 }
            text "6" { at: pc.x.0 - 12, (pc.y.0 + 5 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(6 == win.shown.0, 85%, 40%) }
