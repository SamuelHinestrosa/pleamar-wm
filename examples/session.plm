    on release pcard.3.3 while pdrag.s == 3 and mon != 3 and 3 < win.used.3 { send workspace 4 on 3 to mon }
    on release pcard.3.3 { pdrag.s = -1 }
    on drag pcard.4.3 while pdrag.s < 0 {
