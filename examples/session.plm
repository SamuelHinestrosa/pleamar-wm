            opacity: smooth(0.40, 0.95, ov) * if(pdrag.s == 3 and pdrag.k == 8, 40%, 100%)
            move: 70 * (1 - smooth(0.40, 0.95, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.8.3.hover, (overview and drop.ok and mon == 3 and drop.k == 9 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.8.3.hover, 28, 45%
                box { from: pc.x.3, (pc.y.3 + 8 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10 }
            }
            box { from: pc.x.3 - 3, (pc.y.3 + 8 * (pc.h.3 + 20)) - 3; size: pc.w.3 + 6, pc.h.3 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(9 == win.shown.3, 85%, 0%) + 60% * (overview and drop.ok and mon == 3 and drop.k == 9 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 8 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 9 == pc.n.3 and win.used.3 < 9 }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 8 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 9 == pc.n.3 and win.used.3 < 9 }
            text "9" { at: pc.x.3 - 12, (pc.y.3 + 8 * (pc.h.3 + 20)) + pc.h.3 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(9 == win.shown.3, 85%, 40%) }
            zone box pcard.8.3 { from: pc.x.3, (pc.y.3 + 8 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10; cursor: pointer; active: overview and not sharing and 8 < pc.n.3 }
        }
        group {
            show: 9 < pc.n.3
            opacity: smooth(0.45, 1.00, ov) * if(pdrag.s == 3 and pdrag.k == 9, 40%, 100%)
            move: 70 * (1 - smooth(0.45, 1.00, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.9.3.hover, (overview and drop.ok and mon == 3 and drop.k == 10 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.9.3.hover, 28, 45%
                box { from: pc.x.3, (pc.y.3 + 9 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10 }
            }
            box { from: pc.x.3 - 3, (pc.y.3 + 9 * (pc.h.3 + 20)) - 3; size: pc.w.3 + 6, pc.h.3 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(10 == win.shown.3, 85%, 0%) + 60% * (overview and drop.ok and mon == 3 and drop.k == 10 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 9 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 10 == pc.n.3 and win.used.3 < 10 }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 9 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 10 == pc.n.3 and win.used.3 < 10 }
            text "10" { at: pc.x.3 - 12, (pc.y.3 + 9 * (pc.h.3 + 20)) + pc.h.3 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(10 == win.shown.3, 85%, 40%) }
            zone box pcard.9.3 { from: pc.x.3, (pc.y.3 + 9 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10; cursor: pointer; active: overview and not sharing and 9 < pc.n.3 }
        }
    }
    on drag pcard.0.3 while pdrag.s < 0 {
        pdrag.s = 3
        pdrag.k = 0
    }
    on release pcard.0.3 while pdrag.s < 0 {
        workspace 1 on 3
        overview = false
    }
    on release pcard.0.3 while pdrag.s == 3 and mon != 3 and 0 < win.used.3 { send workspace 1 on 3 to mon }
    on release pcard.0.3 { pdrag.s = -1 }
    on drag pcard.1.3 while pdrag.s < 0 {
        pdrag.s = 3
        pdrag.k = 1
    }
    on release pcard.1.3 while pdrag.s < 0 {
        workspace 2 on 3
        overview = false
    }
    on release pcard.1.3 while pdrag.s == 3 and mon != 3 and 1 < win.used.3 { send workspace 2 on 3 to mon }
