// The same window manager as examples/windows.plm, as a session of its own:
// the whole monitor, with no compositor underneath. From a TTY of its own
// (Ctrl+Alt+F3, logged in there):
//
//   ./session.sh              ./session.sh --seconds 45   (leaves by itself)
//
//   Ctrl+Alt+Backspace  leave        Ctrl+Alt+F1…F12  another TTY
//
//   Super+T / Super+Return  a terminal     Super+Q  close the one with the keyboard
//   Super+arrows        the keyboard to the next / previous window
//   Super+Shift+Left    make it lead (if it already leads, to the left monitor)
//   Super+Shift+Right   to the right monitor
//   Super+Shift+Up/Down change places with the one before / after it
//   Super+Tab  everything at a glance       Super+-/+  the leader narrower / wider
//   Super+F    fullscreen, and back
//   Super+Space  Marea's search (the wallpaper and Marea start with it: autostart)
//   Touchpad: three fingers down close, up fullscreen; four
//   sideways, the keyboard to the next / previous window
//   With the mouse: carry a window by its title bar; let it go on another one
//   and they change places, or at the edge and it goes to the other monitor.
//
// What Hyprland does not do: its animations are curves of a fixed length that
// start again when interrupted, and its layout is code of its own. Here every
// window rides a spring —change your mind halfway and it turns without a jolt—,
// the layout is twelve lines anyone can rewrite, and the ones without the
// keyboard fade to grey instead of just dimming.
language 0.1
scene Session {
    // One copy per monitor: each lays out its own windows (`win.$i.screen`).
    surface { size: full, full; screens: each max 2 }
    windows win max 6

    let ink = #f5f7f5
    let mint = #9ed6bd
    let coral = #ef7a66
    let bar = 52
    let gap = 12
    let tb = 30                          // each window's title bar
    let W = screen.width
    let H = screen.height
    // Where a window comes from and goes back to: the launcher on the left of the bar.
    let home.x = 24
    let home.y = 12
    spring glide = 210, 23

    fact ratio = 0.56                    // the leader's share of the width
    fact overview = false
    fact dragging = -1                   // the window being carried by its title bar
    fact grab.x = 0                      // where it was taken from, from its corner
    fact grab.y = 0
    fact over = -1                       // the window under the one carried
    fact landing = -1                    // let go on the other monitor, and which
    fact landing.to = 0
    // The mouse on the whole desktop: which monitor, and where on it. Each
    // copy only knows its own; the one the mouse is over says it.
    fact mon = 0
    fact mouse.x = 0
    fact mouse.y = 0
    on change pointer.x + pointer.y * 8192 while pointer.x >= 0 and pointer.x < W and pointer.y >= 0 and pointer.y < H {
        mon = screen.index
        mouse.x = pointer.x
        mouse.y = pointer.y
    }
    prop ov = 0 ~calm
    follow ov = if(overview, 1, 0)

    // ── the desk ──
    // Nothing: the wallpaper is a program's (swaybg, below everything). Only
    // a light that follows the keyboard: where you are typing is a little warmer.
    prop lx = 750 ~slow
    prop ly = 470 ~slow
    // The monitor of the one with the keyboard: only there the light shows.
    let fscreen = pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen)
    group {
        blur: 160
        opacity: 12% * min(win.count, 1) * (fscreen == screen.index) * (win.focus >= 0)
        mode: screen
        ellipse { at: lx, ly; radius: 420; color: #9ed6bd }
    }

    // Where the one with the keyboard is in the order of all of them, and how many there are.
    let focus_at = (win.order.1 == win.focus) + 2 * (win.order.2 == win.focus) + 3 * (win.order.3 == win.focus) + 4 * (win.order.4 == win.focus) + 5 * (win.order.5 == win.focus)
    let all = max(win.count, 1)

    // ── carrying a window: how the others would be if it were let go here ──
    // Its monitor and place; each window's turn in the order of all of them.
    let dsc = pick(max(dragging, 0), win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen)
    let dplace = max(pick(max(dragging, 0), win.0.place, win.1.place, win.2.place, win.3.place, win.4.place, win.5.place), 0)
    let ord.0 = 1 * (win.order.1 == 0) + 2 * (win.order.2 == 0) + 3 * (win.order.3 == 0) + 4 * (win.order.4 == 0) + 5 * (win.order.5 == 0)
    let ord.1 = 1 * (win.order.1 == 1) + 2 * (win.order.2 == 1) + 3 * (win.order.3 == 1) + 4 * (win.order.4 == 1) + 5 * (win.order.5 == 1)
    let ord.2 = 1 * (win.order.1 == 2) + 2 * (win.order.2 == 2) + 3 * (win.order.3 == 2) + 4 * (win.order.4 == 2) + 5 * (win.order.5 == 2)
    let ord.3 = 1 * (win.order.1 == 3) + 2 * (win.order.2 == 3) + 3 * (win.order.3 == 3) + 4 * (win.order.4 == 3) + 5 * (win.order.5 == 3)
    let ord.4 = 1 * (win.order.1 == 4) + 2 * (win.order.2 == 4) + 3 * (win.order.3 == 4) + 4 * (win.order.4 == 4) + 5 * (win.order.5 == 4)
    let ord.5 = 1 * (win.order.1 == 5) + 2 * (win.order.2 == 5) + 3 * (win.order.3 == 5) + 4 * (win.order.4 == 5) + 5 * (win.order.5 == 5)
    let ordD = pick(max(dragging, 0), ord.0, ord.1, ord.2, ord.3, ord.4, ord.5)
    // Over the other monitor it would go there: there they make room for it,
    // and on its own the rest close up. Its turn there is its turn in the order.
    let crossing = dragging >= 0 and mon != dsc
    let landing.place = (win.0.open and win.0.screen == mon and ord.0 < ordD) + (win.1.open and win.1.screen == mon and ord.1 < ordD) + (win.2.open and win.2.screen == mon and ord.2 < ordD) + (win.3.open and win.3.screen == mon and ord.3 < ordD) + (win.4.open and win.4.screen == mon and ord.4 < ordD) + (win.5.open and win.5.screen == mon and ord.5 < ordD)
    let landing.n = pick(mon, win.on.0, win.on.1) + 1

    repeat i in 0..6 {
        // A window is laid out on its own monitor: how big that one is and how
        // many windows share it. Each copy of the scene draws only its own.
        let sc = win.$i.screen
        let here = win.$i.open and sc == screen.index
        let n = max(pick(sc, win.on.0, win.on.1), 1)
        // ── where it goes: the leader on the left, the rest stacked on the right ──
        let p = max(win.$i.place, 0)
        let Ws = pick(sc, screen.0.width, screen.1.width) - pick(sc, win.reserved.0.left, win.reserved.1.left) - pick(sc, win.reserved.0.right, win.reserved.1.right)
        let Hs = pick(sc, screen.0.height, screen.1.height) - pick(sc, win.reserved.0.top, win.reserved.1.top) - pick(sc, win.reserved.0.bottom, win.reserved.1.bottom)
        let areah = Hs - bar - gap
        let lead.w = if(n < 1.5, Ws - 2 * gap, (Ws - 3 * gap) * ratio)
        let stack.h = (areah - (n - 2) * gap) / max(n - 1, 1)
        let tx = pick(sc, win.reserved.0.left, win.reserved.1.left) + if(p < 0.5, gap, 2 * gap + lead.w)
        let ty = pick(sc, win.reserved.0.top, win.reserved.1.top) + if(p < 0.5, bar, bar + (p - 1) * (stack.h + gap))
        let tw = if(p < 0.5, lead.w, Ws - 3 * gap - lead.w)
        let th = if(p < 0.5, areah, stack.h)
        // Under the mouse while another is carried —measured on where it is,
        // not where it is shown moving aside—: it would change places with it.
        let under = dragging >= 0 and dragging != i and win.$i.open and sc == mon and mouse.x >= tx and mouse.x < tx + tw and mouse.y >= ty and mouse.y < ty + th
        on change under {
            over = if(under, i, if(over == i, -1, over))
        }
        // ── where it is shown going, while one is carried ── (the program is
        // asked for that size too: it changes only when the mouse goes onto
        // another window or monitor, so it draws itself as it would be
        // instead of being stretched)
        let ord.me = pick(i, ord.0, ord.1, ord.2, ord.3, ord.4, ord.5)
        let swaps = over == i and not crossing and sc == dsc
        let n.shown = max(if(crossing and sc == mon, n + 1, if(crossing and sc == dsc, n - 1, n)), 1)
        let p.shown = if(swaps, dplace, if(crossing and sc == mon, p + (ordD < ord.me), if(crossing and sc == dsc, p - (ord.me > ordD), p)))
        let Wsv = pick(sc, screen.0.width, screen.1.width) - pick(sc, win.reserved.0.left, win.reserved.1.left) - pick(sc, win.reserved.0.right, win.reserved.1.right)
        let Hsv = pick(sc, screen.0.height, screen.1.height) - pick(sc, win.reserved.0.top, win.reserved.1.top) - pick(sc, win.reserved.0.bottom, win.reserved.1.bottom)
        let areahv = Hsv - bar - gap
        let lead.wv = if(n.shown < 1.5, Wsv - 2 * gap, (Wsv - 3 * gap) * ratio)
        let stack.hv = (areahv - (n.shown - 2) * gap) / max(n.shown - 1, 1)
        let txv = pick(sc, win.reserved.0.left, win.reserved.1.left) + if(p.shown < 0.5, gap, 2 * gap + lead.wv)
        let tyv = pick(sc, win.reserved.0.top, win.reserved.1.top) + if(p.shown < 0.5, bar, bar + (p.shown - 1) * (stack.hv + gap))
        let twv = if(p.shown < 0.5, lead.wv, Wsv - 3 * gap - lead.wv)
        let thv = if(p.shown < 0.5, areahv, stack.hv)
        // Where the carried one would land on the other monitor.
        let Wsg = pick(mon, screen.0.width, screen.1.width) - pick(mon, win.reserved.0.left, win.reserved.1.left) - pick(mon, win.reserved.0.right, win.reserved.1.right)
        let Hsg = pick(mon, screen.0.height, screen.1.height) - pick(mon, win.reserved.0.top, win.reserved.1.top) - pick(mon, win.reserved.0.bottom, win.reserved.1.bottom)
        let areahg = Hsg - bar - gap
        let lead.wg = if(landing.n < 1.5, Wsg - 2 * gap, (Wsg - 3 * gap) * ratio)
        let stack.hg = (areahg - (landing.n - 2) * gap) / max(landing.n - 1, 1)
        let txg = pick(mon, win.reserved.0.left, win.reserved.1.left) + if(landing.place < 0.5, gap, 2 * gap + lead.wg)
        let tyg = pick(mon, win.reserved.0.top, win.reserved.1.top) + if(landing.place < 0.5, bar, bar + (landing.place - 1) * (stack.hg + gap))
        let twg = if(landing.place < 0.5, lead.wg, Wsg - 3 * gap - lead.wg)
        let thg = if(landing.place < 0.5, areahg, stack.hg)
        // (the grid at a glance)
        let cols = ceil(sqrt(n))
        let rows = ceil(n / cols)
        let cell.w = (Ws - 80 - (cols - 1) * 30) / cols
        let cell.h = (areah - 40 - (rows - 1) * 30) / rows
        // ── and at a glance: in a grid, each one keeping its shape ──
        let s = min(cell.w / tw, cell.h / th)
        let ox = pick(sc, win.reserved.0.left, win.reserved.1.left) + 40 + mod(p, cols) * (cell.w + 30) + (cell.w - tw * s) / 2
        let oy = pick(sc, win.reserved.0.top, win.reserved.1.top) + bar + 20 + floor(p / cols) * (cell.h + 30) + (cell.h - th * s) / 2

        prop x.$i = 24 ~glide
        prop y.$i = 12 ~glide
        prop w.$i = 60 ~glide
        prop h.$i = 34 ~glide
        follow x.$i = if(win.$i.open, if(overview, ox, txv), home.x)
        follow y.$i = if(win.$i.open, if(overview, oy, tyv), home.y)
        follow w.$i = if(win.$i.open, if(overview, tw * s, twv), 60)
        follow h.$i = if(win.$i.open, if(overview, th * s, thv), 34)
        // Carried with the mouse: how far from its place.
        prop dx.$i = 0 ~glide
        prop dy.$i = 0 ~glide
        prop seen.$i = 0 ~300ms
        follow seen.$i = if(win.$i.open, 1, 0)
        prop lit.$i = 0 ~220ms
        follow lit.$i = if(win.$i.focused and not overview, 1, if(overview, 1, 0))

        let x = x.$i + dx.$i
        let y = y.$i + dy.$i
        let w = w.$i
        let h = h.$i
        // A hollow where the carried one would land: where this one is, if it
        // is under it; its own place, if it is under nothing; its place on the
        // other monitor, if it is over that one.
        // (A prop is one for every monitor's copy: what it follows cannot
        // depend on which copy it is. Which monitor shows it goes in `show`.)
        let hollow.there = dragging == i and crossing
        prop hollow.$i = 0 ~140ms
        follow hollow.$i = if(swaps or (dragging == i and over < 0 and not crossing) or hollow.there, 1, 0)
        let hx = if(hollow.there, txg, tx)
        let hy = if(hollow.there, tyg, ty)
        let hw = if(hollow.there, twg, tw)
        let hh = if(hollow.there, thg, th)
        group {
            show: hollow.$i > 0.01 and if(hollow.there, mon, sc) == screen.index
            opacity: hollow.$i
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; color: mint; opacity: 7% }
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; stroke: 1.5; color: mint; opacity: 55% }
        }
        group {
            // Carried, it is drawn over the others, further down.
            show: seen.$i > 0.01 and sc == screen.index and dragging != i and not (landing == i and sc != landing.to) and not win.$i.dialog
            opacity: seen.$i
            pivot: x + w / 2, y + h / 2
            scale: 0.92 + 0.08 * seen.$i + 0.025 * pick.$i.hover * ov
            body {
                color: #0c0e10
                shadow: 0, 14 + 8 * lit.$i, 34, 45% + 20% * lit.$i
                box { from: x, y; size: w, h; corner: 12 }
            }
            // Without the keyboard, grey and a step back.
            group {
                saturation: 0.3 + 0.7 * lit.$i
                brightness: 0.72 + 0.28 * lit.$i
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb; color: mix(#1a1e22, #1d2b27, lit.$i) }
                text win.$i.title { at: x + 14, y + tb / 2; anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: 55% + 45% * lit.$i }
                window win.$i { at: x, y + tb; size: w, max(h - tb, 1); ask: twv, thv - tb; show: here and not win.$i.fullscreen }
            }
            // Its two buttons: to the front, and away.
            ellipse { at: x + w - 40, y + tb / 2; radius: 5.5 + lead_zone.$i.hover; color: mint; opacity: 35% + 50% * lead_zone.$i.hover }
            ellipse { at: x + w - 20, y + tb / 2; radius: 5.5 + close_zone.$i.hover; color: coral; opacity: 45% + 50% * close_zone.$i.hover }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: lit.$i * 70% * (1 - ov) }
        }
        // Where it is laid out, not where it is carried: a drag goes on while
        // its zone still holds the point it was pressed on.
        zone box title.$i { from: x.$i, y.$i; size: w - 56, tb; cursor: pointer; active: here and not overview and not win.$i.dialog }
        zone ellipse lead_zone.$i { at: x + w - 40, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog }
        zone ellipse close_zone.$i { at: x + w - 20, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog }
        // At a glance, the whole window is a button: pressing it chooses it.
        zone box pick.$i { from: x, y; size: w, h; cursor: pointer; active: here and overview and not win.$i.dialog }
        on press title.$i {
            focus win.$i
            grab.x = pointer.x - x.$i
            grab.y = pointer.y - y.$i
        }
        // Carried by its title bar. Let go on another window, they change
        // places; at the edge towards the other monitor, it goes there.
        // (While carried it is drawn at the mouse, further down; its place
        // here waits.)
        // Only the one that started it: another shown moving aside may come
        // to hold the point pressed.
        on drag title.$i while dragging < 0 or dragging == i {
            dragging = i
        }
        // Let go, it starts from where it was left —on the monitor it was left
        // on— and glides to its place from there.
        on release title.$i {
            dragging = -1
            dx.$i: mouse.x - grab.x - x.$i ~0ms
            dy.$i: mouse.y - grab.y - y.$i ~0ms
            dx.$i: 0 after 30ms
            dy.$i: 0 after 30ms
        }
        // Let go on another one (the one under it, as the others showed).
        on release title.$i while over >= 0 and not crossing { swap win.$i with win(over) }
        // Let go on the other monitor (the mouse is off this one), or at the
        // edge that leads to it.
        // Until the compositor says it is there, it stays with the mouse
        // (`landing`): not a frame back on the monitor it left.
        on release title.$i while pointer.y < 0 or pointer.y > H {
            send win.$i to 1 - screen.index
            landing = i
            landing.to = 1 - screen.index
        }
        on release title.$i while screen.index == 0 and pointer.x > W - 40 and pointer.y >= 0 and pointer.y <= H {
            send win.$i to 1
            landing = i
            landing.to = 1
        }
        on release title.$i while screen.index == 1 and pointer.x < 40 and pointer.y >= 0 and pointer.y <= H {
            send win.$i to 0
            landing = i
            landing.to = 0
        }
        on release title.$i {
            over = -1
        }
        on press lead_zone.$i { promote win.$i }
        on press close_zone.$i { close win.$i }
        on press pick.$i {
            focus win.$i
            overview = false
        }
        // The light goes where the keyboard is.
        on change win.$i.focused while win.$i.focused {
            lx: tx + tw / 2
            ly: ty + th / 2
        }
    }

    // ── the bar ──
    // Under what other programs' bars keep at the top of this monitor.
    box { from: 0, pick(screen.index, win.reserved.0.top, win.reserved.1.top); size: W, bar - 6; color: #0d1013; opacity: 80% }
    row {
        at: 16, 8 + pick(screen.index, win.reserved.0.top, win.reserved.1.top)
        gap: 8
        repeat a in 0..3 {
            group {
                size: 124, 30
                box { from: 0, 0; size: 124, 30; corner: 15; color: mix(#1b2024, #22302b, app.$a.hover) }
                text pick(a, "+  Terminal", "+  Calculator", "+  Text") { at: 62, 15; anchor: center; size: 12; weight: 500; color: ink; opacity: 70% + 30% * app.$a.hover }
                zone box app.$a { from: 0, 0; size: 124, 30; corner: 15; cursor: pointer }
            }
        }
        group {
            size: 124, 30
            box { from: 0, 0; size: 124, 30; corner: 15; color: mix(mix(#1b2024, #22302b, glance.hover), #2b4a40, ov) }
            text "At a glance" { at: 62, 15; anchor: center; size: 12; weight: 500; color: ink; opacity: 70% + 30% * glance.hover }
            zone box glance { from: 0, 0; size: 124, 30; corner: 15; cursor: pointer }
        }
    }
    on press app.0 { launch "kitty" }
    on press app.1 { launch "gnome-calculator" }
    on press app.2 { launch "gnome-text-editor" }
    on press glance { toggle overview }
    text "{win.count} of 6 · drag a title bar to move it · Super+T terminal · Super+Q close · Super+arrows keyboard · Super+Shift+arrows move · Super+Tab at a glance · Super+Space search · Super+L lock · Ctrl+Alt+Backspace leaves" {
        // Down in the corner: the top middle is Marea's.
        at: W - 18, H - 16 - pick(screen.index, win.reserved.0.bottom, win.reserved.1.bottom); anchor: right center; size: 11; color: ink; opacity: 55%
    }
    text "Nothing open here yet: Super+T, or a button above." { at: W / 2, H / 2; anchor: center; size: 15; color: ink; opacity: if(pick(screen.index, win.on.0, win.on.1) < 0.5, 45%, 0) }

    // The window being carried, over all the others: lifted, a little smaller
    // and see-through, so that where it will land shows below it. It goes with
    // the mouse on the whole desktop: each monitor draws its part of it, so
    // crossing from one to the other it is seen half on each.
    repeat i in 0..6 {
        // Monitor 1 starts where monitor 0 ends.
        let x = mouse.x + screen.0.width * ((mon > 0.5) - (screen.index > 0.5)) - grab.x
        let y = mouse.y - grab.y
        let w = w.$i
        let h = h.$i
        group {
            show: dragging == i or (landing == i and win.$i.screen != landing.to)
            opacity: 88%
            pivot: x + w / 2, y + h / 2
            scale: 1
            body {
                color: #0c0e10
                shadow: 0, 26, 50, 60%
                box { from: x, y; size: w, h; corner: 12 }
            }
            group {
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb; color: #1d2b27 }
                text win.$i.title { at: x + 14, y + tb / 2; anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink }
                window win.$i { at: x, y + tb; size: w, max(h - tb, 1); show: dragging == i or (landing == i and win.$i.screen != landing.to) }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: 80% }
        }
    }

    // ── the keys: Super, as on Hyprland ──
    let fplace = pick(win.focus, win.0.place, win.1.place, win.2.place, win.3.place, win.4.place, win.5.place)
    let next = pick(mod(focus_at + 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    let previous = pick(mod(focus_at + all - 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    on key Super+t { launch "kitty" }
    on key Super+Return { launch "kitty" }
    on key Super+q { close win(win.focus) }
    // Marea's search (she runs in the session: see autostart).
    on key Super+space { launch "$HOME/Proyectos/marea-plm/marea search" }
    // Her screenshots, as on Hyprland: a piece, the screen, the active window.
    on key Print { launch "$HOME/Proyectos/marea-plm/marea shot_region" }
    on key Shift+Print { launch "$HOME/Proyectos/marea-plm/marea shot_screen" }
    on key Ctrl+Print { launch "$HOME/Proyectos/marea-plm/marea shot_window" }
    // Her lock screen (ext-session-lock).
    on key Super+l { launch "$HOME/Proyectos/marea-plm/marea lock" }
    on key Super+Tab { toggle overview }
    on key Escape while overview { overview = false }
    // The keyboard to the next one, or the one before.
    on key Super+Right { focus win(next) }
    on key Super+Down { focus win(next) }
    on key Super+Left { focus win(previous) }
    on key Super+Up { focus win(previous) }
    // Moving it: left, to lead (and if it already leads, to the monitor on the
    // left); right, to the monitor on the right; up and down, in the order.
    on key Super+Shift+Left while fplace > 0.5 { promote win(win.focus) }
    on key Super+Shift+Left while fplace < 0.5 and fscreen > 0.5 { send win(win.focus) to 0 }
    on key Super+Shift+Right while fscreen < 0.5 { send win(win.focus) to 1 }
    on key Super+Shift+Up { swap win(win.focus) with win(previous) }
    on key Super+Shift+Down { swap win(win.focus) with win(next) }
    // The leader narrower or wider.
    on key Super+minus { ratio = clamp(ratio - 0.05, 0.25, 0.8) }
    on key Super+plus { ratio = clamp(ratio + 0.05, 0.25, 0.8) }
    // ── dialogs: a message, a file chooser, a window of another's: over the
    // rest, at the size it chooses, in the middle of its monitor ──
    repeat i in 0..6 {
        let dw = max(win.$i.width, 120)
        let dh = max(win.$i.height, 40) + tb
        let dx = (W - dw) / 2
        let dy = (H - dh) / 2
        prop dlg.$i = 0 ~220ms
        follow dlg.$i = if(win.$i.dialog and win.$i.open, 1, 0)
        group {
            show: dlg.$i > 0.01 and win.$i.screen == screen.index
            opacity: dlg.$i
            pivot: dx + dw / 2, dy + dh / 2
            scale: 0.94 + 0.06 * dlg.$i
            body {
                color: #0c0e10
                shadow: 0, 18, 44, 55%
                box { from: dx, dy; size: dw, dh; corner: 12 }
            }
            group {
                clip box { from: dx, dy; size: dw, dh; corner: 12 }
                box { from: dx, dy; size: dw, tb; color: #1d2b27 }
                text win.$i.title { at: dx + 14, dy + tb / 2; anchor: left center; size: 12; weight: 500; width: max(dw - 40, 10); lines: 1; color: ink }
                window win.$i { at: dx, dy + tb; size: win.$i.width, win.$i.height; ask: 0, 0; show: win.$i.dialog and win.$i.open and win.$i.screen == screen.index }
            }
            box { from: dx, dy; size: dw, dh; corner: 12; stroke: 1.5; color: mint; opacity: 70% * win.$i.focused }
        }
    }

    // ── fullscreen: one that asked (F11, a video, a game) or Super+F covers
    // its monitor, over the bar and the other programs' bars ──
    repeat i in 0..6 {
        let fs.here = win.$i.fullscreen and win.$i.open and win.$i.screen == screen.index
        prop fs.$i = 0 ~160ms
        follow fs.$i = if(win.$i.fullscreen and win.$i.open, 1, 0)
        group {
            show: fs.$i > 0.01 and win.$i.screen == screen.index
            opacity: fs.$i
            box { from: 0, 0; size: W, H; color: #000 }
            window win.$i { at: 0, 0; size: W, H; ask: W, H; show: fs.here }
        }
    }
    on key Super+f { fullscreen win(win.focus) }

    // ── the touchpad: as on Hyprland ──
    // Three fingers down closes; up, fullscreen; four sideways, the keyboard
    // to the next or the one before.
    event swipe3_down
    event swipe3_up
    event swipe4_left
    event swipe4_right
    on swipe3_down { close win(win.focus) }
    on swipe3_up { fullscreen win(win.focus) }
    on swipe4_left { focus win(previous) }
    on swipe4_right { focus win(next) }
}
