        group {
            show: 7 < pc.n.0
            opacity: smooth(0.35, 0.90, ov) * if(pdrag.s == 0 and pdrag.k == 7, 40%, 100%)
            move: 70 * (1 - smooth(0.35, 0.90, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.7.0.hover, (overview and drop.ok and mon == 0 and drop.k == 8 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.7.0.hover, 28, 45%
                box { from: pc.x.0, (pc.y.0 + 7 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10 }
