// The same window manager as examples/windows.plm, as a session of its own:
// the whole monitor, with no compositor underneath. From a TTY of its own
// (Ctrl+Alt+F3, logged in there):
//
//   ./session.sh              ./session.sh --seconds 45   (leaves by itself)
//
//   Ctrl+Alt+Backspace  leave        Ctrl+Alt+F1…F12  another TTY
//
//   Super+T / Super+Return  a terminal     Super+Q  close the one with the keyboard
//   Super+arrows        the keyboard to the next / previous window
//   Super+Shift+Left    make it lead (if it already leads, to the left monitor)
//   Super+Shift+Right   to the right monitor
//   Super+Shift+Up/Down change places with the one before / after it
//   Super+Tab  everything at a glance       Super+-/+  the leader narrower / wider
//   Super+Space  Marea's search (the wallpaper and Marea start with it: autostart)
//   With the mouse: carry a window by its title bar; let it go on another one
//   and they change places, or at the edge and it goes to the other monitor.
//
// What Hyprland does not do: its animations are curves of a fixed length that
// start again when interrupted, and its layout is code of its own. Here every
// window rides a spring —change your mind halfway and it turns without a jolt—,
// the layout is twelve lines anyone can rewrite, and the ones without the
// keyboard fade to grey instead of just dimming.
language 0.1
scene Session {
    // One copy per monitor: each lays out its own windows (`win.$i.screen`).
    surface { size: full, full; screens: each max 2 }
    windows win max 6

    let ink = #f5f7f5
    let mint = #9ed6bd
    let coral = #ef7a66
    let bar = 52
    let gap = 12
    let tb = 30                          // each window's title bar
    let W = screen.width
    let H = screen.height
    // Where a window comes from and goes back to: the launcher on the left of the bar.
    let home.x = 24
    let home.y = 12
    spring glide = 210, 23

    fact ratio = 0.56                    // the leader's share of the width
    fact overview = false
    fact dragging = -1                   // the window being carried by its title bar
    prop ov = 0 ~calm
    follow ov = if(overview, 1, 0)

    // ── the desk ──
    // Nothing: the wallpaper is a program's (swaybg, below everything). Only
    // a light that follows the keyboard: where you are typing is a little warmer.
    prop lx = 750 ~slow
    prop ly = 470 ~slow
    // The monitor of the one with the keyboard: only there the light shows.
    let fscreen = pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen)
    group {
        blur: 160
        opacity: 12% * min(win.count, 1) * (fscreen == screen.index) * (win.focus >= 0)
        mode: screen
        ellipse { at: lx, ly; radius: 420; color: #9ed6bd }
    }

    // Where the one with the keyboard is in the order of all of them, and how many there are.
    let focus_at = (win.order.1 == win.focus) + 2 * (win.order.2 == win.focus) + 3 * (win.order.3 == win.focus) + 4 * (win.order.4 == win.focus) + 5 * (win.order.5 == win.focus)
    let all = max(win.count, 1)

    repeat i in 0..6 {
        // A window is laid out on its own monitor: how big that one is and how
        // many windows share it. Each copy of the scene draws only its own.
        let sc = win.$i.screen
        let here = win.$i.open and sc == screen.index
        let Ws = pick(sc, screen.0.width, screen.1.width)
        let Hs = pick(sc, screen.0.height, screen.1.height)
        let n = max(pick(sc, win.on.0, win.on.1), 1)
        let areah = Hs - bar - gap
        let lead.w = if(n < 1.5, Ws - 2 * gap, (Ws - 3 * gap) * ratio)
        let stack.h = (areah - (n - 2) * gap) / max(n - 1, 1)
        let cols = ceil(sqrt(n))
        let rows = ceil(n / cols)
        let cell.w = (Ws - 80 - (cols - 1) * 30) / cols
        let cell.h = (areah - 40 - (rows - 1) * 30) / rows
        // ── where it goes: the leader on the left, the rest stacked on the right ──
        let p = max(win.$i.place, 0)
        let leads = p < 0.5
        let tx = if(leads, gap, 2 * gap + lead.w)
        let ty = if(leads, bar, bar + (p - 1) * (stack.h + gap))
        let tw = if(leads, lead.w, Ws - 3 * gap - lead.w)
        let th = if(leads, areah, stack.h)
        // ── and at a glance: in a grid, each one keeping its shape ──
        let s = min(cell.w / tw, cell.h / th)
        let ox = 40 + mod(p, cols) * (cell.w + 30) + (cell.w - tw * s) / 2
        let oy = bar + 20 + floor(p / cols) * (cell.h + 30) + (cell.h - th * s) / 2

        prop x.$i = 24 ~glide
        prop y.$i = 12 ~glide
        prop w.$i = 60 ~glide
        prop h.$i = 34 ~glide
        follow x.$i = if(win.$i.open, if(overview, ox, tx), home.x)
        follow y.$i = if(win.$i.open, if(overview, oy, ty), home.y)
        follow w.$i = if(win.$i.open, if(overview, tw * s, tw), 60)
        follow h.$i = if(win.$i.open, if(overview, th * s, th), 34)
        // Carried with the mouse: how far from its place.
        prop dx.$i = 0 ~glide
        prop dy.$i = 0 ~glide
        prop seen.$i = 0 ~300ms
        follow seen.$i = if(win.$i.open, 1, 0)
        prop lit.$i = 0 ~220ms
        follow lit.$i = if(win.$i.focused and not overview, 1, if(overview, 1, 0))

        let x = x.$i + dx.$i
        let y = y.$i + dy.$i
        let w = w.$i
        let h = h.$i
        group {
            // Carried, it is drawn over the others, further down.
            show: seen.$i > 0.01 and sc == screen.index and dragging != i
            opacity: seen.$i
            pivot: x + w / 2, y + h / 2
            scale: 0.92 + 0.08 * seen.$i + 0.025 * pick.$i.hover * ov
            body {
                color: #0c0e10
                shadow: 0, 14 + 8 * lit.$i, 34, 45% + 20% * lit.$i
                box { from: x, y; size: w, h; corner: 12 }
            }
            // Without the keyboard, grey and a step back.
            group {
                saturation: 0.3 + 0.7 * lit.$i
                brightness: 0.72 + 0.28 * lit.$i
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb; color: mix(#1a1e22, #1d2b27, lit.$i) }
                text win.$i.title { at: x + 14, y + tb / 2; anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: 55% + 45% * lit.$i }
                window win.$i { at: x, y + tb; size: w, max(h - tb, 1); ask: tw, th - tb; show: here }
            }
            // Its two buttons: to the front, and away.
            ellipse { at: x + w - 40, y + tb / 2; radius: 5.5 + lead_zone.$i.hover; color: mint; opacity: 35% + 50% * lead_zone.$i.hover }
            ellipse { at: x + w - 20, y + tb / 2; radius: 5.5 + close_zone.$i.hover; color: coral; opacity: 45% + 50% * close_zone.$i.hover }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: lit.$i * 70% * (1 - ov) }
        }
        // Where it is laid out, not where it is carried: a drag goes on while
        // its zone still holds the point it was pressed on.
        zone box title.$i { from: x.$i, y.$i; size: w - 56, tb; cursor: pointer; active: here and not overview }
        zone ellipse lead_zone.$i { at: x + w - 40, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview }
        zone ellipse close_zone.$i { at: x + w - 20, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview }
        // At a glance, the whole window is a button: pressing it chooses it.
        zone box pick.$i { from: x, y; size: w, h; cursor: pointer; active: here and overview }
        on press title.$i { focus win.$i }
        // Carried by its title bar. Let go on another window, they change
        // places; at the edge towards the other monitor, it goes there.
        on drag title.$i {
            dragging = i
            dx.$i: drag.dx ~16ms
            dy.$i: drag.dy ~16ms
        }
        on release title.$i {
            dragging = -1
            dx.$i: 0
            dy.$i: 0
        }
        repeat j in 0..6 {
            on release title.$i while j != i and win.$j.open and win.$j.screen == sc and pointer.x >= x.$j and pointer.x < x.$j + w.$j and pointer.y >= y.$j and pointer.y < y.$j + h.$j { swap win.$i with win.$j }
        }
        // Let go on the other monitor (the mouse is off this one), or at the
        // edge that leads to it.
        on release title.$i while pointer.y < 0 or pointer.y > H { send win.$i to 1 - screen.index }
        on release title.$i while screen.index == 0 and pointer.x > W - 40 and pointer.y >= 0 and pointer.y <= H { send win.$i to 1 }
        on release title.$i while screen.index == 1 and pointer.x < 40 and pointer.y >= 0 and pointer.y <= H { send win.$i to 0 }
        on press lead_zone.$i { promote win.$i }
        on press close_zone.$i { close win.$i }
        on press pick.$i {
            focus win.$i
            overview = false
        }
        // The light goes where the keyboard is.
        on change win.$i.focused while win.$i.focused {
            lx: tx + tw / 2
            ly: ty + th / 2
        }
    }

    // The window being carried, over all the others: lifted, a little smaller
    // and see-through, so that where it will land shows below it.
    repeat i in 0..6 {
        let x = x.$i + dx.$i
        let y = y.$i + dy.$i
        let w = w.$i
        let h = h.$i
        group {
            show: dragging == i and win.$i.screen == screen.index
            opacity: 88%
            pivot: x + w / 2, y + h / 2
            scale: 0.96
            body {
                color: #0c0e10
                shadow: 0, 26, 50, 60%
                box { from: x, y; size: w, h; corner: 12 }
            }
            group {
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb; color: #1d2b27 }
                text win.$i.title { at: x + 14, y + tb / 2; anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink }
                window win.$i { at: x, y + tb; size: w, max(h - tb, 1); show: dragging == i }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: 80% }
        }
    }

    // ── the bar ──
    box { from: 0, 0; size: W, bar - 6; color: #0d1013; opacity: 80% }
    row {
        at: 16, 8
        gap: 8
        repeat a in 0..3 {
            group {
                size: 124, 30
                box { from: 0, 0; size: 124, 30; corner: 15; color: mix(#1b2024, #22302b, app.$a.hover) }
                text pick(a, "+  Terminal", "+  Calculator", "+  Text") { at: 62, 15; anchor: center; size: 12; weight: 500; color: ink; opacity: 70% + 30% * app.$a.hover }
                zone box app.$a { from: 0, 0; size: 124, 30; corner: 15; cursor: pointer }
            }
        }
        group {
            size: 124, 30
            box { from: 0, 0; size: 124, 30; corner: 15; color: mix(mix(#1b2024, #22302b, glance.hover), #2b4a40, ov) }
            text "At a glance" { at: 62, 15; anchor: center; size: 12; weight: 500; color: ink; opacity: 70% + 30% * glance.hover }
            zone box glance { from: 0, 0; size: 124, 30; corner: 15; cursor: pointer }
        }
    }
    on press app.0 { launch "kitty" }
    on press app.1 { launch "gnome-calculator" }
    on press app.2 { launch "gnome-text-editor" }
    on press glance { toggle overview }
    text "{win.count} of 6 · drag a title bar to move it · Super+T terminal · Super+Q close · Super+arrows keyboard · Super+Shift+arrows move · Super+Tab at a glance · Super+Space search · Ctrl+Alt+Backspace leaves" {
        // Down in the corner: the top middle is Marea's.
        at: W - 18, H - 16; anchor: right center; size: 11; color: ink; opacity: 55%
    }
    text "Nothing open here yet: Super+T, or a button above." { at: W / 2, H / 2; anchor: center; size: 15; color: ink; opacity: if(pick(screen.index, win.on.0, win.on.1) < 0.5, 45%, 0) }

    // ── the keys: Super, as on Hyprland ──
    let fplace = pick(win.focus, win.0.place, win.1.place, win.2.place, win.3.place, win.4.place, win.5.place)
    let next = pick(mod(focus_at + 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    let previous = pick(mod(focus_at + all - 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    on key Super+t { launch "kitty" }
    on key Super+Return { launch "kitty" }
    on key Super+q { close win(win.focus) }
    // Marea's search (she runs in the session: see autostart).
    on key Super+space { launch "$HOME/Proyectos/marea-plm/marea search" }
    on key Super+Tab { toggle overview }
    on key Escape while overview { overview = false }
    // The keyboard to the next one, or the one before.
    on key Super+Right { focus win(next) }
    on key Super+Down { focus win(next) }
    on key Super+Left { focus win(previous) }
    on key Super+Up { focus win(previous) }
    // Moving it: left, to lead (and if it already leads, to the monitor on the
    // left); right, to the monitor on the right; up and down, in the order.
    on key Super+Shift+Left while fplace > 0.5 { promote win(win.focus) }
    on key Super+Shift+Left while fplace < 0.5 and fscreen > 0.5 { send win(win.focus) to 0 }
    on key Super+Shift+Right while fscreen < 0.5 { send win(win.focus) to 1 }
    on key Super+Shift+Up { swap win(win.focus) with win(previous) }
    on key Super+Shift+Down { swap win(win.focus) with win(next) }
    // The leader narrower or wider.
    on key Super+minus { ratio = clamp(ratio - 0.05, 0.25, 0.8) }
    on key Super+plus { ratio = clamp(ratio + 0.05, 0.25, 0.8) }
}
