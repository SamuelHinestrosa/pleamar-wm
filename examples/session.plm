    on release pcard.5.3 while pdrag.s == 3 and mon != 3 and 5 < win.used.3 { send workspace 6 on 3 to mon }
    on release pcard.5.3 { pdrag.s = -1 }
    on drag pcard.6.3 while pdrag.s < 0 {
