    on release pcard.6.3 while pdrag.s == 3 and mon != 3 and 6 < win.used.3 { send workspace 7 on 3 to mon }
    on release pcard.6.3 { pdrag.s = -1 }
    on drag pcard.7.3 while pdrag.s < 0 {
