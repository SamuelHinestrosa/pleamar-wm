    }
    on release pcard.7.3 while pdrag.s == 3 and mon != 3 and 7 < win.used.3 { send workspace 8 on 3 to mon }
    on release pcard.7.3 { pdrag.s = -1 }
    on drag pcard.8.3 while pdrag.s < 0 {
