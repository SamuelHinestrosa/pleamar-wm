    on release pcard.4.3 while pdrag.s == 3 and mon != 3 and 4 < win.used.3 { send workspace 5 on 3 to mon }
    on release pcard.4.3 { pdrag.s = -1 }
    on drag pcard.5.3 while pdrag.s < 0 {
